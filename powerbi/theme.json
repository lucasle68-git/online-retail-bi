{
  "name": "Online Retail BI",
  "dataColors": ["#1F5FAD", "#8FA3BF", "#C2410C", "#0F766E", "#B6C2D3", "#5B6472", "#D5D9DF", "#374151"],
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#5B6472",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F5F7",
  "tableAccent": "#1F5FAD",
  "good": "#0F7A4A",
  "neutral": "#8FA3BF",
  "bad": "#C2410C",
  "textClasses": {
    "callout": { "fontSize": 24, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "title":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5B6472" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F5F7" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E6EA" } }, "radius": 8 }]
      }
    }
  }
}
