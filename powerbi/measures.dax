// =====================================================================
// powerbi/measures.dax  |  Step 8c: DAX measures (table _Measures)
// ---------------------------------------------------------------------
// The .pbix file is binary, so every measure is also kept here as text:
// readable on GitHub and easy to review. Definitions: docs/metric_definitions.md
// KPI scope: product lines only (Product[Is Product] = TRUE), except where named "All Lines".
// =====================================================================

// ---------- 1 Revenue ----------
Net Amount (All Lines) =
SUM ( Sales[Net Amount] )                                   // reconciliation only: 19,002,944.28

Net Revenue =
CALCULATE ( SUM ( Sales[Net Amount] ), Product[Is Product] = TRUE () )   // 18,927,399.07

Gross Sales =
CALCULATE ( SUM ( Sales[Gross Sales Amount] ), Product[Is Product] = TRUE () )

Cancelled Value =
CALCULATE ( SUM ( Sales[Cancelled Amount] ), Product[Is Product] = TRUE () )

Cancellation Rate =
DIVIDE ( [Cancelled Value], [Gross Sales] )                 // about 3.6%

// ---------- 2 Orders and customers ----------
Orders =
CALCULATE (
    DISTINCTCOUNT ( Sales[Invoice No] ),
    Product[Is Product] = TRUE (),
    Sales[Is Cancellation] = FALSE ()
)

Average Order Value =
DIVIDE ( [Gross Sales], [Orders] )

Units Sold =
CALCULATE (
    SUM ( Sales[Quantity] ),
    Product[Is Product] = TRUE (),
    Sales[Is Cancellation] = FALSE ()
)

Active Customers =
CALCULATE (
    DISTINCTCOUNT ( Sales[customer_key] ),
    Product[Is Product] = TRUE (),
    Sales[Is Cancellation] = FALSE (),
    Customer[Is Known Customer] = TRUE ()
)                                                           // whole period: 5,853

Repeat Customers =
VAR BuyingCustomers =
    CALCULATETABLE (
        VALUES ( Sales[customer_key] ),
        Product[Is Product] = TRUE (),
        Sales[Is Cancellation] = FALSE (),
        Customer[Is Known Customer] = TRUE ()
    )
RETURN
    COUNTROWS ( FILTER ( BuyingCustomers, [Orders] >= 2 ) )   // whole period: 4,234

Repeat Customer Rate =
DIVIDE ( [Repeat Customers], [Active Customers] )           // whole period: 72.3%

Unknown Customer Revenue % =
DIVIDE (
    CALCULATE ( [Net Revenue], Customer[Is Known Customer] = FALSE () ),
    [Net Revenue]
)                                                           // 13.6%

// ---------- 3 Time intelligence (needs 'Date' marked as date table) ----------
Net Revenue PY =
CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )

Net Revenue YoY % =
VAR CurrentRevenue = [Net Revenue]
VAR PriorRevenue   = [Net Revenue PY]
RETURN
    IF ( NOT ISBLANK ( PriorRevenue ), DIVIDE ( CurrentRevenue - PriorRevenue, PriorRevenue ) )

Net Revenue YTD =
TOTALYTD ( [Net Revenue], 'Date'[Date] )

Net Revenue Rolling 3M =
CALCULATE (
    [Net Revenue],
    DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -3, MONTH )
)

// ---------- 4 Data quality and freshness ----------
Rows Received =
CALCULATE ( SUM ( 'Data Quality'[Rows] ), 'Data Quality'[Step Order] = 0 )      // 1,067,371

Rows In Model =
CALCULATE ( SUM ( 'Data Quality'[Rows] ), 'Data Quality'[Step Order] = 10 )     // 1,029,620

Rows Excluded =
[Rows Received] - [Rows In Model]                                               // 37,751

Last Refreshed Label =
"Data refreshed " & FORMAT ( MAX ( 'Pipeline Status'[Last Refreshed] ), "d mmm yyyy, hh:nn" )
